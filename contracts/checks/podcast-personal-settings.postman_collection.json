{
  "info": {
    "name": "WildString personal podcast policies and access",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:18822"
    }
  ],
  "item": [
    {
      "name": "01 Owner login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Wildstring-Client",
            "value": "web"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"admin\", \"password\": \"disposable-storage-check-password\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Require disposable fixture",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Wildstring-Client",
            "value": "web"
          }
        ],
        "url": "{{base_url}}/api/v1/podcasts/storage-resource-fixture"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "const safe=pm.response.json().podcast?.title==='Storage Resource Fixture';pm.test('isolated fixture',()=>pm.expect(safe).to.eql(true));if(!safe)pm.execution.setNextRequest(null);"
            ]
          }
        }
      ]
    },
    {
