      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "const b=pm.response.json();pm.collectionVariables.set('show',b.podcast.id);for(const e of b.episodes)pm.collectionVariables.set(e.guid,e.id);pm.test('six real parsed episodes',()=>pm.expect(b.episodes.length).to.eql(6));"
            ]
          }
        }
      ]
