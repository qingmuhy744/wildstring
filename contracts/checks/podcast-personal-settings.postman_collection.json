              "const b=pm.response.json().items;pm.test('one physical audio shared by two users',()=>pm.expect(b.find(x=>x.id===pm.collectionVariables.get('policy-6')).reference_count).to.eql(2));pm.test('outside fixed window not downloaded',()=>pm.expect(b.some(x=>x.id===pm.collectionVariables.get('policy-1'))).to.eql(false));"
            ]
          }
        }
      ]
    },
    {
      "name": "28 Queue has no duplicate episode tasks",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Wildstring-Client",
            "value": "web"
          }
        ],
        "url": "{{base_url}}/api/v1/podcasts/downloads/queue"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "const b=pm.response.json();pm.test('no duplicate completions',()=>{const ids=b.recent_completed.filter(x=>x.podcast_id===pm.collectionVariables.get('show')).map(x=>x.episode_id);pm.expect(new Set(ids).size).to.eql(ids.length);});"
            ]
          }
        }
      ]
    }
  ]
}
