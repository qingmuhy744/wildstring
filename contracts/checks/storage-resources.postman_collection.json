{
  "info": {
    "name": "WildString isolated storage resource regression",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Only run against an isolated disposable container seeded with Storage Resource Fixture; never against an existing user instance."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:18801"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if(!/^http:\\/\\/(127\\.0\\.0\\.1|localhost):\\d+$/.test(pm.variables.get('base_url'))) throw new Error('Local isolated fixture required');",
          "if(!pm.collectionVariables.get('run_id'))pm.collectionVariables.set('run_id',String(Date.now()));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Owner login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Wildstring-Client",
            "value": "web"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"admin\", \"password\": \"disposable-storage-check-password\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));"]
          }
        }
      ]
    },
    {
      "name": "02 Require isolated fixture before mutations",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Wildstring-Client",
            "value": "web"
          }
        ],
        "url": "{{base_url}}/api/v1/podcasts/storage-resource-fixture"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const b=pm.response.json(); const safe=pm.response.code===200 && b.podcast?.title==='Storage Resource Fixture'; pm.test('isolated fixture marker',()=>pm.expect(safe).to.eql(true)); if(!safe)pm.execution.setNextRequest(null);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Read cleanup policy",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Wildstring-Client",
            "value": "web"
          }
        ],
        "url": "{{base_url}}/api/v1/podcasts/resources/settings"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('policy_version',pm.response.json().version); pm.test('automatic cleanup initially off',()=>pm.expect(pm.response.json().enabled).to.eql(false));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Save policy with version",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "X-Wildstring-Client",
            "value": "web"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/podcasts/resources/settings",
        "body": {
          "mode": "raw",
          "raw": "{\"version\": {{policy_version}}, \"enabled\": false, \"retention_days\": 7}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('policy version advances',()=>pm.expect(pm.response.json().version).to.eql(Number(pm.collectionVariables.get('policy_version'))+1));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Stale policy rejected",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "X-Wildstring-Client",
            "value": "web"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/podcasts/resources/settings",
        "body": {
          "mode": "raw",
          "raw": "{\"version\": {{policy_version}}, \"enabled\": true, \"retention_days\": 0}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('HTTP 409', () => pm.response.to.have.status(409));"]
          }
        }
      ]
    },
    {
      "name": "06 Create listener without music grants",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Wildstring-Client",
            "value": "web"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/manage/users",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"storage-saver-{{run_id}}\", \"password\": \"disposable-saver-password\", \"profile\": \"listener\", \"library_ids\": []}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('saver_username',pm.response.json().username);"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Owner save reuses bytes",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Wildstring-Client",
            "value": "web"
          }
