{
  "info": {
    "name": "WildString catalog access isolated checks",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Only use a disposable scripts/serve_web_tests.py fixture and the RSS simulation; never an existing user server."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:18813"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if(!/^http:\\/\\/127\\.0\\.0\\.1:\\d+$/.test(pm.variables.get('base_url'))) throw new Error('Disposable local server required'); if(!pm.collectionVariables.get('run_id'))pm.collectionVariables.set('run_id',String(Date.now()));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Owner login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Wildstring-Client",
            "value": "web"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"admin\", \"password\": \"disposable-browser-test-password\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Require disposable fixture",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Wildstring-Client",
            "value": "web"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/podcasts/radio-test"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const safe=pm.response.code===200 && pm.response.json().podcast?.title==='午后广播测试'; pm.test('Disposable fixture required',()=>pm.expect(safe).to.eql(true)); if(!safe)pm.execution.setNextRequest(null);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Owner sees newcomer defaults",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Wildstring-Client",
            "value": "web"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/libraries"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const libs=pm.response.json(); const lib=libs.find(x=>!x.is_default); pm.expect(lib).to.exist; pm.collectionVariables.set('library',JSON.stringify(lib)); pm.test('Default library preserves newcomer access',()=>pm.expect(libs.find(x=>x.is_default).default_access).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Configure newcomer access",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "X-Wildstring-Client",
            "value": "web"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/libraries/{{library_id}}",
        "body": {
          "mode": "raw",
          "raw": "{{library_update}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const lib=JSON.parse(pm.collectionVariables.get('library')); pm.variables.set('library_id',lib.id); pm.variables.set('library_update',JSON.stringify({name:lib.name,source_roots:lib.sources.map(x=>x.root),version:lib.version,default_access:true}));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Newcomer default enabled',()=>pm.expect(pm.response.json().default_access).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 New account inherits configured defaults",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Wildstring-Client",
            "value": "web"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/manage/users",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"default-check-{{run_id}}\", \"password\": \"disposable-default-check-password\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('default_user',pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Verify default grants",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Wildstring-Client",
            "value": "web"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/libraries/access/{{default_user}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const lib=JSON.parse(pm.collectionVariables.get('library')); pm.test('New user has opted-in library',()=>pm.expect(pm.response.json().library_ids).to.include(lib.id));"
            ]
          }
        }
      ]
    },
