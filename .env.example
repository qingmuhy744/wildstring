# Local development. Copy with `make env`; existing .env files are preserved.
WILDSTRING_ENVIRONMENT=development
WILDSTRING_HOST=127.0.0.1
WILDSTRING_PORT=18780
WILDSTRING_DATA_DIR=./runtime
# Read-only import source. Compose resolves host paths from the repository root.
WILDSTRING_MUSIC_DIR=./music
# Managed copies default to WILDSTRING_DATA_DIR/library (container: /data/library).
# Local Python only; custom container paths need an explicit persistent mount.
# WILDSTRING_LIBRARY_DIR=./runtime/library

# Container image version or digest. Set to a release tag when using GHCR.
WILDSTRING_IMAGE=wildstring:dev

# Optional first-start admin password (12–128 characters). Never commit a real value.
# Existing administrators are not overwritten; use make admin / make docker-admin to reset.
# WILDSTRING_ADMIN_PASSWORD=
# Enable only when accessing the service through HTTPS.
WILDSTRING_COOKIE_SECURE=false

# Optional build-only proxy; use the host gateway instead of container loopback.
# DOCKER_HTTP_PROXY=http://host.docker.internal:7890
# DOCKER_HTTPS_PROXY=http://host.docker.internal:7890

# AI/provider credentials belong only in private configuration or deployment secrets.
# External metadata is disabled until enabled in Web settings.

# Runtime networking for metadata / Last.fm. Web settings can choose environment, custom or direct.
# Use an address reachable from the container; URL-encode proxy credentials.
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=127.0.0.1,localhost

# Podcast directory search (Apple Podcasts / iTunes, no key). Comma-separated storefronts,
# searched in parallel and merged; Web admin settings override this default when saved.
# WILDSTRING_PODCAST_SEARCH_REGIONS=us,tw,cn
# Once after start-up (default 180 s later) fill missing Apple ids for old shows; never merges.
# WILDSTRING_PODCAST_IDENTITY_AUTO_BACKFILL=true
# WILDSTRING_PODCAST_IDENTITY_AUTO_BACKFILL_DELAY_SECONDS=180
