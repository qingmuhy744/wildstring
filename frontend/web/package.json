{
  "name": "wildstring-web",
  "version": "0.8.14",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "icons": "node scripts/build-icons.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test"
  },
  "dependencies": {
    "i18next": "^26.7.2",
    "i18next-browser-languagedetector": "^8.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.1.13",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "prettier": "^3.6.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
