    "settings.handoff.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Progress is saved when you pause. Only pauses from other devices in the last 30 minutes are offered, once each; playback stays paused after loading."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停时自动保存进度；仅提示其他设备最近 30 分钟内的暂停，每次暂停只提示一次；载入后保持暂停。"
          }
        }
      }
    },
